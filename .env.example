# Docker Compose reads this file after you copy it to .env.
# Local preview works without external credentials. Never enable it on a public deployment.
APP_ENV=development
LOCAL_DEMO_MODE=true
NEXT_PUBLIC_LOCAL_DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://leadflow:leadflow@db:5432/leadflow
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow
POSTGRES_DB=leadflow
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Fill these for real signup, login, and Google OAuth.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
